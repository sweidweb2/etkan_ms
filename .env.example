# Copy to .env.local (host `npm run dev`) or .env.staging / .env.production (Docker).
# Hosted project keys and notes belong in .env.hosted (gitignored; Next does not load it).
# Do not commit real keys. Restart `npm run dev` after changing NEXT_PUBLIC_* values.

# --- Required ---

# Public app origin (no trailing slash). Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local CLI stack: http://127.0.0.1:54321  (keys from `npx supabase status`)
# Hosted / staging / prod: https://<project-ref>.supabase.co  (dashboard keys)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Mailtrap (manager emailing; SaaS, no container) ---

# MAILTRAP_API_KEY=
# MAILTRAP_FROM_EMAIL=
# MAILTRAP_FROM_NAME=Etkan MS
# MAILTRAP_TEST_TO=

# --- Cloudflare Turnstile (public /register) ---
# Production TURNSTILE_HOSTNAMES must be the live hostname(s), not localhost.

# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET=
# TURNSTILE_HOSTNAMES=localhost,127.0.0.1

# --- Cloudflare Workers AI (schedule assistant) ---

# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_AI_API_TOKEN=
# CLOUDFLARE_AI_MODEL=

# --- Optional ---

# Backup export of hosted Auth settings (SMTP, templates, OAuth). Not needed for local CLI.
# SUPABASE_ACCESS_TOKEN=

# Seed / smoke script overrides
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=Admin123!
# SEED_ADMIN_USERNAME=admin
# SEED_MANAGER_EMAIL=
# SEED_MANAGER_PASSWORD=
# SEED_MANAGER_USERNAME=
# SEED_DEMO_PASSWORD=Demo123!
# SMOKE_USER_ID=

# Debug flags (leave unset in staging/prod)
# NEXT_PUBLIC_NAV_DEBUG=0
# SCHEDULE_ASSISTANT_DEBUG=0
