# Copy to .env.local (host `npm run dev`).
# VPS: copy .env.staging.example → .env.staging and .env.production.example → .env.production.
# Hosted project keys and notes belong in .env.hosted (gitignored; Next does not load it).
# Do not commit real keys. Restart `npm run dev` after changing NEXT_PUBLIC_* values.

# --- Required ---

# Public app origin (no trailing slash). Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local CLI stack: http://127.0.0.1:54321  (keys from `npx supabase status`)
# VPS staging/prod (planned): https://api.etkan.org  (keys from .env.supabase.vps)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Mailtrap (manager emailing; SaaS, no container) ---

# MAILTRAP_API_KEY=
# MAILTRAP_FROM_EMAIL=
# MAILTRAP_FROM_NAME=Etkan MS
# MAILTRAP_TEST_TO=

# --- Cloudflare Turnstile (public /register) ---
# Local: localhost. VPS staging+prod share one widget:
# TURNSTILE_HOSTNAMES=etkan.org,www.etkan.org,staging.etkan.org

# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET=
# TURNSTILE_HOSTNAMES=localhost,127.0.0.1

# --- Optional ---

# Backup export of hosted Auth settings (SMTP, templates, OAuth). Not needed for local CLI.
# SUPABASE_ACCESS_TOKEN=

# Seed / smoke script overrides
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=Admin123!
# SEED_ADMIN_FULL_NAME=Admin
# SEED_MANAGER_EMAIL=
# SEED_MANAGER_PASSWORD=
# SEED_MANAGER_FULL_NAME=
# SEED_DEMO_PASSWORD=Demo123!
# SMOKE_USER_ID=

# Debug flags (leave unset in staging/prod)
# NEXT_PUBLIC_NAV_DEBUG=0

# --- Playwright E2E (host runner; see docs/[07] Reports/e2e/[03] local-setup.md) ---
# App must already be up on this URL (npm run dev or Docker-mapped :3000).
# Maintenance mode must stay OFF for auth E2E.
# E2E_BASE_URL=http://127.0.0.1:3000
# Set when Next runs in Docker (or you always start the app yourself):
# E2E_SKIP_WEBSERVER=1
# Credentials (fallbacks = seed script defaults when unset):
# E2E_MANAGER_EMAIL=
# E2E_MANAGER_PASSWORD=
# E2E_TEACHER_EMAIL=
# E2E_TEACHER_PASSWORD=
# E2E_STUDENT_EMAIL=
# E2E_STUDENT_PASSWORD=
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=
# E2E_CEO_EMAIL=
# E2E_CEO_PASSWORD=
# E2E_CRM_EMAIL=
# E2E_CRM_PASSWORD=
# E2E_SUPERVISOR_EMAIL=
# E2E_SUPERVISOR_PASSWORD=
# E2E_CO_MANAGER_EMAIL=
# E2E_CO_MANAGER_PASSWORD=
# Optional invite smokes (Phase 2):
# E2E_GUEST_TOKEN=
# E2E_FINANCIAL_TOKEN=
# E2E_ALLOW_REGISTER=0
# E2E_ALLOW_EMAIL=0
# E2E_ALLOW_MONEY=0
