# VPS reverse proxy. DNS for both hosts must point at this machine.
# First cert issue is easier with Cloudflare DNS-only (grey cloud), then Full (strict).

staging.etkan.org {
	encode gzip
	reverse_proxy host.docker.internal:3001
}

www.etkan.org {
	redir https://etkan.org{uri} permanent
}

etkan.org {
	encode gzip
	reverse_proxy host.docker.internal:3000
}
