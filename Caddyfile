# VPS reverse proxy. DNS for these hosts must point at this machine.
# First cert issue is easier with Cloudflare DNS-only (grey cloud), then Full (strict).
# Kong on the Supabase CLI stack is host port 54321 (not 8000).

staging.etkan.org {
	encode gzip
	reverse_proxy host.docker.internal:3001
}

api.etkan.org {
	encode gzip
	reverse_proxy host.docker.internal:54321
}

# Prod Supabase Kong (second stack; host port 55321). Staging stays on 54321.
prod-api.etkan.org {
	encode gzip
	reverse_proxy host.docker.internal:55321
}

# Serve both hosts (no www↔apex bounce). A split DNS period
# (apex still on Vercel, www on this VPS) plus opposite redirects
# caused ERR_TOO_MANY_REDIRECTS.
www.etkan.org {
	encode gzip
	reverse_proxy host.docker.internal:3000
}

etkan.org {
	encode gzip
	reverse_proxy host.docker.internal:3000
}
