# Copy to .env.staging (gitignored). Used by compose.staging.yaml at runtime.
# NEXT_PUBLIC_* for the Docker image are baked in GitHub Actions (not from this file).
# Keep NEXT_PUBLIC_* here in sync for local emergency builds only.

# --- App (staging only) ---

NEXT_PUBLIC_SITE_URL=https://staging.etkan.org

# --- Self-hosted Supabase on the VPS (staging stack only) ---
# Public Kong/API URL (browser + Next). Not *.supabase.co and not prod-api.
# Keys come from `npx supabase status` in /home/deploy/etkan_ms.
# Also add STAGING_SUPABASE_ANON_KEY as a GitHub repo secret (same anon value).

NEXT_PUBLIC_SUPABASE_URL=https://api.etkan.org
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Shared SaaS (same values as .env.production) ---
# Copy Mailtrap / Turnstile from .env.hosted (3rd party block).

MAILTRAP_API_KEY=
MAILTRAP_FROM_EMAIL=noreply@etkan.org
MAILTRAP_FROM_NAME=Etkan MS

# One Turnstile widget: allow all live hosts on the Cloudflare site too.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=etkan.org,www.etkan.org,staging.etkan.org
