# Copy to .env.production (gitignored). Used by compose.prod.yaml.
# Rebuild the image after changing NEXT_PUBLIC_* — they are baked in at build.

# --- App (production only) ---

NEXT_PUBLIC_SITE_URL=https://etkan.org

# --- Self-hosted Supabase on the VPS (prod stack only) ---
# Public Kong/API URL (browser + Next). Not *.supabase.co and not api.etkan.org.
# Keys come from `npx supabase status` in /home/deploy/etkan_supabase_prod.

NEXT_PUBLIC_SUPABASE_URL=https://prod-api.etkan.org
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Shared SaaS (same values as .env.staging) ---
# Copy Mailtrap / Cloudflare AI / Turnstile from .env.hosted (3rd party block).

MAILTRAP_API_KEY=
MAILTRAP_FROM_EMAIL=noreply@etkan.org
MAILTRAP_FROM_NAME=Etkan MS

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
CLOUDFLARE_AI_MODEL=

# One Turnstile widget: allow all live hosts on the Cloudflare site too.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=etkan.org,www.etkan.org,staging.etkan.org
