# VPS self-hosted Supabase (official Docker), not Cloud and not local CLI.
# Copy to .env.supabase.vps next to the official supabase/docker .env when you
# add that stack. Do not `up` it from this repo yet — config only.
# Next.js reads ANON / SERVICE_ROLE via .env.staging and .env.production.

# Public API (Caddy → Kong). Must match NEXT_PUBLIC_SUPABASE_URL on both apps.
API_EXTERNAL_URL=https://api.etkan.org
SUPABASE_PUBLIC_URL=https://api.etkan.org
KONG_HTTP_PORT=8000

# Auth Site URL = production app. Add both callbacks as additional redirects.
SITE_URL=https://etkan.org
ADDITIONAL_REDIRECT_URLS=https://etkan.org/auth/callback,https://staging.etkan.org/auth/callback

# Generated by the official stack (JWT secret + derived anon / service_role).
# Paste the same ANON_KEY and SERVICE_ROLE_KEY into .env.staging and .env.production.
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
POSTGRES_PASSWORD=

# Studio / DB stay off the public internet (localhost or private network only).
STUDIO_PORT=54323
POSTGRES_PORT=5432
