# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
# jsPDF doc.save() leftovers from export unit tests (also cleaned in afterEach)
*-grade-sheet-*.pdf

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (including *.example) — never commit
.env*

# local Next / Supabase config (ports can differ per machine)
next.config.ts
supabase/config.toml

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Cloud → VPS dumps (PII / passwords hashes). Never commit.
/tmp/cloud-dump/

# Local Storage dumps (binary). Manifest under scripts/data/ is OK to commit.
/supabase/dumps/storage/
