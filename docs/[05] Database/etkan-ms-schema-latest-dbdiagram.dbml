Table guests {
  id uuid [pk, default: `gen_random_uuid()`]
  full_name text [not null]
  phone text
  age integer [note: 'nullable; age > 0 when set']
  school_or_university text
  education_level text [note: 'nullable: school | uni_year_1 | uni_year_2 | uni_year_3 | uni_year_4_plus | uni_graduate | other']
  interested_service text [note: 'nullable: etkan_roadmap | private | workshops']
  status text [not null, default: 'scheduled', note: 'scheduled | pending | cancelled | rejected | finished']
  notes text
  created_by uuid
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table teams {
  id uuid [pk, default: `gen_random_uuid()`]
  name text [not null, note: 'unique case-insensitive via lower(name)']
  expected_start_date date
  status text [not null, default: 'scheduled', note: 'scheduled | cancelled | started']
  created_by uuid
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (status) [name: 'idx_teams_status']
    (created_at) [name: 'idx_teams_created_at', note: 'created_at DESC']
  }

  Note: 'Named groups of guests from manage guests. Membership is exclusive.'
}

Table team_guests {
  id uuid [pk, default: `gen_random_uuid()`]
  team_id uuid [not null]
  guest_id uuid [not null, unique, note: 'at most one team per guest']
  created_by uuid
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (team_id) [name: 'idx_team_guests_team_id']
  }
}

Table guest_status_events {
  id uuid [pk, default: `gen_random_uuid()`]
  guest_id uuid [not null]
  status text [not null, note: 'started | finished_meeting | finished_parent_meeting | chose_plan | routed_correctly | finishing_routing_doc | finished']
  note text
  created_by uuid
  created_at timestamptz [not null, default: `now()`]
}

Table guest_registration_invites {
  id uuid [pk, default: `gen_random_uuid()`]
  guest_id uuid [not null, unique]
  token text [not null, unique]
  application_id uuid
  created_by uuid
  created_at timestamptz [not null, default: `now()`]
  used_at timestamptz
  cancelled_at timestamptz
}

Table student_registration_applications {
  id uuid [pk, default: `gen_random_uuid()`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  status text [not null, default: 'pending', note: 'open | pending | accepted | applied | missing | rejected | cancelled']
  notes text
  guest_id uuid [note: 'nullable; at most one non-cancelled per guest']
  user_id uuid [note: 'nullable; at most one non-cancelled per user']
  full_name text [not null]
  gender text [not null]
  date_of_birth date [not null]
  blood_type text [not null]
  email text [not null]
  phone text [not null]
  additional_phone text
  city text [not null]
  full_address text [not null]
  education_level text [not null]
  organization_name text
  speciality text
  learning_status text [not null]
  graduation_year integer
  self_learning_notes text
  learning_goal text [not null]
  skills text[] [not null]
  skills_other text
  referral_source text [not null]
  referral_other text
  preferred_program text [not null]
  available_days text[] [not null]
  preferred_shifts text[] [not null]
  weekly_available_hours integer [not null]
  job_status text [not null]
  has_transportation boolean [not null]
  consent_terms boolean [not null]
  consent_privacy boolean [not null]
  guardian_name text
  guardian_phone text
  id_document_type text
}

Table student_registration_documents {
  id uuid [pk, default: `gen_random_uuid()`]
  application_id uuid [not null]
  file_name text [not null]
  mime_type text [not null]
  file_size integer [not null]
  sort_order integer [not null]
  storage_path text [not null, unique]
  created_at timestamptz [not null, default: `now()`]
}

Table gallery_images {
  id uuid [pk, default: `gen_random_uuid()`]
  name text [not null]
  storage_path text [not null, unique, note: 'Object path in the public gallery bucket, including the gallery/ prefix']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (created_at) [name: 'idx_gallery_images_created_at']
  }

  Note: 'Public gallery page images. Display URL is built from storage_path. Bucket: gallery (public read, service-role writes).'
}

Table public_projects {
  id uuid [pk, default: `gen_random_uuid()`]
  classification text [not null, note: "CHECK in ('students','teachers','etkan')"]
  category text [not null, note: 'Free-text category, e.g. mobile app']
  title text [not null]
  body text [not null]
  image_url text [not null, note: 'Public Storage URL from projects bucket']
  href text [note: 'Optional internal path or external URL']
  author text [note: 'Maker display name']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (classification, created_at) [name: 'idx_public_projects_classification_created']
  }

  Note: '''
    Project cards on public /projects. English-only copy.
    Storage bucket: projects (public read, authenticated write).
  '''
}

Table blogs {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  slug text [not null, note: 'UNIQUE; URL-safe lowercase']
  title text [not null]
  summary text [not null]
  body_html text [not null, default: '', note: 'CHECK char_length <= 200000']
  categories text[] [not null, default: '{}', note: 'Free-text labels; CHECK via blog_categories_within_bounds()']
  thumbnail_url text [note: 'Storage bucket blogs']
  author_name text [not null]
  author_avatar_url text [note: 'Storage bucket auther']
  status text [not null, default: 'draft', note: "CHECK in ('draft','published')"]
  is_featured boolean [not null, default: false, note: 'At most one true — partial unique index']
  reading_time_minutes integer [not null, default: 1]
  published_at timestamptz
  sources text[] [not null, default: '{}', note: 'CHECK via blog_sources_within_bounds()']
  meta_title text [note: 'CMS SEO; CHECK 2..120 when set']
  meta_description text [note: 'CMS SEO; CHECK 2..300 when set']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (slug) [unique, name: 'blogs_slug_uidx']
    (is_featured) [unique, name: 'blogs_one_featured_uidx', note: 'WHERE is_featured = true']
    (status, published_at) [name: 'blogs_status_published_at_idx', note: 'published_at DESC']
    (created_at) [name: 'blogs_created_at_idx', note: 'created_at DESC']
    categories [type: gin, name: 'blogs_categories_gin_idx']
    title [type: gin, name: 'blogs_title_trgm_idx', note: 'pg_trgm gin_trgm_ops']
    author_name [type: gin, name: 'blogs_author_name_trgm_idx', note: 'pg_trgm gin_trgm_ops']
  }

  Note: '''
    Storage buckets (public read, authenticated write):
    - blogs — cover/thumbnail images
    - auther — author avatars

    English-only content; EN/AR public pages show the same posts.
  '''
}

