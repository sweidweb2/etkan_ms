Table auth_users {
  id uuid [pk]
}

Table profiles {
  id uuid [pk]
  username text [unique]
  role text [not null, default: 'student']
  is_instructor boolean [not null, default: false]
  is_mentor boolean [not null, default: false]
  created_at timestamp [default: `now()`]
}

Table student_profiles {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, unique]
  full_name text [not null]
  birth_date date
  phone text
  status text [default: 'active']
  created_at timestamp [default: `now()`]
}

Table semesters {
  id uuid [pk, default: `gen_random_uuid()`]
  name text [not null]
  nb_courses integer [not null, default: 0]
  amount numeric(10,2) [not null, default: 0]
  status text [not null, default: 'scheduled']
  start_date date
  semester_code text [not null, unique]
  created_at timestamp [default: `now()`]
}

Table subjects {
  id uuid [pk, default: `gen_random_uuid()`]
  name text [not null]
  syllabus_link text
  reference_link text
  handout_link text
  nb_sessions integer [not null, default: 0]
  created_at timestamp [default: `now()`]
}

Table categories {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  parent_id uuid [note: 'Self-parent']
  name text [not null, note: "trim(name) <> ''"]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    parent_id [name: 'categories_parent_id_idx']
    (`lower(trim(name))`) [unique, name: 'categories_name_unique_idx']
  }

  Note: 'Hierarchy via parent_id. Names are unique case-insensitively after trim.'
}

Table exercises {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  title text [not null, note: "trim(title) <> ''"]
  body jsonb [not null, note: 'Tiptap JSON document']
  level exercise_level [not null, default: 'easy']
  status exercise_status [not null, default: 'active']
  categories text[] [not null, default: `'{}'`, note: 'Denormalized category names, not FKs. cardinality > 0']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    level [name: 'exercises_level_idx']
    status [name: 'exercises_status_idx']
    categories [type: gin, name: 'exercises_categories_idx']
    created_at [name: 'exercises_created_at_idx']
  }

  Note: '''
    categories is a text[] of category names (copied at write time).
    There is no FK to categories.id.
  '''
}

Table category_exercises {
  category_id uuid [not null]
  exercise_id uuid [not null]

  indexes {
    (category_id, exercise_id) [pk]
    exercise_id [name: 'category_exercises_exercise_id_idx']
  }
}

Table subject_categories {
  subject_id uuid [not null]
  category_id uuid [not null]

  indexes {
    (subject_id, category_id) [pk]
    category_id [name: 'subject_categories_category_id_idx']
  }
}

Table subject_exercises {
  subject_id uuid [not null]
  exercise_id uuid [not null]

  indexes {
    (subject_id, exercise_id) [pk]
    exercise_id [name: 'subject_exercises_exercise_id_idx']
  }
}

Table classes {
  id uuid [pk, default: `gen_random_uuid()`]
  subject_id uuid
  semester_id uuid
  name text [not null]
  status text [not null, default: 'scheduled']
  image_url text
  created_at timestamp [default: `now()`]

  Note: 'image_url is a public class-covers Storage URL. Null means no cover.'
}

Table class_categories {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  class_id uuid [not null]
  category_id uuid [not null]
  status class_category_status [not null, default: 'in_progress']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    class_id [name: 'class_categories_class_id_idx']
    category_id [name: 'class_categories_category_id_idx']
    (class_id, status) [name: 'class_categories_class_id_status_idx']
    (class_id, category_id) [unique, name: 'class_categories_class_category_unique']
  }

  Note: 'Follow-up status of a category for a class. No row = not taken (pool).'
}

Table class_teacher {
  id uuid [pk, default: `gen_random_uuid()`]
  teacher_id uuid [not null]
  class_id uuid [not null]
  assigned_by uuid
  assigned_at timestamp [default: `now()`]

  Note: 'teacher_id is any profile (class instructor assignment), not limited to role = teacher.'
}

Table student_semester {
  id uuid [pk, default: `gen_random_uuid()`]
  student_profile_id uuid [not null]
  semester_id uuid [not null]
  status text [not null, default: 'pending']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (student_profile_id, semester_id) [unique]
  }
}

Table student_class {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  class_id uuid [not null]
  joined_at timestamp [default: `now()`]

  Note: 'Binary membership: row exists = student is in the class (no status column).'

  indexes {
    (user_id, class_id) [unique]
  }
}

Table sessions {
  id uuid [pk, default: `gen_random_uuid()`]
  class_id uuid [not null]
  semester_id uuid
  nb_order integer [not null]
  topic text [not null]
  session_report text
  starts_at timestamptz [not null]
  ends_at timestamptz [not null]
  group_grade_level text
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (class_id, nb_order) [unique]
  }
}

Table weekly_schedule_slots {
  id uuid [pk, default: `gen_random_uuid()`]
  name text [not null]
  type text [not null, note: 'class | workshop | online | meeting']
  slot_date date [not null]
  start_time time [not null]
  end_time time [not null]
  color text [not null, default: '#BAE6FD', note: '#RRGGBB pastel hex']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (name, slot_date, start_time, end_time) [unique]
  }
}

Table instructor_schedule_slots {
  id uuid [pk, default: `gen_random_uuid()`]
  entity_type text [not null, note: 'instructor | workshop']
  record_id uuid [not null, note: 'profiles.id or workshops.id by entity_type']
  name text [not null]
  type text [not null, note: 'free | busy']
  slot_date date [not null, note: 'Created/anchor date (informative)']
  day_of_week smallint [not null, note: '0=Sunday … 6=Saturday; weekly recurrence']
  start_time time [not null]
  end_time time [not null]
  color text [not null, default: '#BAE6FD', note: '#RRGGBB hex']
  source_workshop_id uuid [ref: > workshops.id, note: 'Set on instructor mirrors copied from a workshop']
  source_slot_id uuid [ref: > instructor_schedule_slots.id, note: 'Workshop slot this mirror was copied from']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (entity_type, record_id, name, day_of_week, start_time, end_time) [unique]
    (entity_type, record_id, day_of_week)
    (source_workshop_id)
    (source_slot_id)
  }
}

Table workshops {
  id uuid [pk, default: `gen_random_uuid()`]
  name text [not null]
  subject text [note: 'Free-text topic (not FK to subjects)']
  status text [not null, default: 'draft', note: 'draft | proposal | scheduled | in_progress | completed | cancelled']
  type text [not null, default: 'workshop', note: 'course | private | workshop']
  phone text
  target_audience text
  nb_participants integer
  proposal_notes text
  number_of_sessions integer
  price numeric(12,2)
  start_date date
  end_date date
  delivery_place text
  created_by uuid [ref: > profiles.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    (status)
    (start_date)
    (created_by)
    (deleted_at)
  }
}

Table workshop_instructors {
  id uuid [pk, default: `gen_random_uuid()`]
  workshop_id uuid [not null, ref: > workshops.id]
  user_id uuid [not null, ref: > profiles.id]
  role text [not null, note: 'lead | assistant | guest']
  wage_type text [not null, note: 'fixed | per_session | percentage']
  wage_amount numeric(12,2)
  notes text
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (workshop_id, user_id) [unique]
    (workshop_id)
    (user_id)
  }
}

Table workshop_documents {
  id uuid [pk, default: `gen_random_uuid()`]
  workshop_id uuid [not null, ref: > workshops.id]
  name text [not null]
  storage_path text [not null]
  file_size bigint
  mime_type text
  uploaded_by uuid [ref: > profiles.id]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (workshop_id, storage_path) [unique]
    (workshop_id)
  }
}

Table workshop_payments {
  id uuid [pk, default: `gen_random_uuid()`]
  workshop_id uuid [not null, ref: > workshops.id]
  amount numeric(12,2) [not null]
  type text [not null, note: 'debit | credit']
  payment_date date [not null]
  payment_method text
  notes text
  created_by uuid [ref: > profiles.id]
  created_at timestamptz [not null, default: `now()`]
  transaction_id uuid [ref: - transactions.id, note: 'mirrored income-statement transaction']

  indexes {
    (workshop_id)
    (payment_date)
    (type)
    (transaction_id) [unique]
  }
}

Table workshop_sessions {
  id uuid [pk, default: `gen_random_uuid()`]
  workshop_id uuid [not null, ref: > workshops.id]
  nb_order integer [not null, note: '1-based order within workshop']
  session_date date [not null]
  start_time time [not null]
  end_time time [not null]
  nb_hours numeric(5,2) [not null]
  topic text [not null]
  notes text
  suggestions text
  status text [not null, default: 'planned', note: 'planned | done']
  participants_eval smallint [note: '1–10 optional']
  session_eval smallint [note: '1–10 optional']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (workshop_id, nb_order) [unique]
    (workshop_id)
    (workshop_id, session_date)
    (workshop_id, status)
  }
}

Table attendee {
  id uuid [pk, default: `gen_random_uuid()`]
  session_id uuid [not null]
  student_id uuid [not null]
  status text [not null, default: 'present']
  note text
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (session_id, student_id) [unique]
  }
}

Table tasks {
  id uuid [pk, default: `gen_random_uuid()`]
  session_id uuid
  title text [not null]
  description text
  due_date timestamp
  max_grade numeric(5,2)
  created_at timestamp [default: `now()`]
}

Table student_tasks {
  id uuid [pk, default: `gen_random_uuid()`]
  task_id uuid [not null]
  student_id uuid [not null]
  status text [not null, default: 'pending']
  submitted_at timestamp
  grade numeric(5,2)
  notes text
  student_report text
  graded_at timestamp

  indexes {
    (task_id, student_id) [unique, name: 'student_tasks_task_student_unique']
  }
}

Table student_task_uploads {
  id uuid [pk, default: `gen_random_uuid()`]
  student_task_id uuid [not null]
  storage_path text [not null, unique]
  file_name text [not null]
  mime_type text [not null]
  file_size integer [not null]
  uploaded_by uuid
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (student_task_id)
  }
}

Table final_exam {
  id uuid [pk, default: `gen_random_uuid()`]
  class_id uuid [not null, unique]
  title text [not null]
  description text
  due_date timestamptz
  max_grade numeric(5,2)
  created_at timestamptz [not null, default: `now()`]
}

Table student_finalexam_grade {
  id uuid [pk, default: `gen_random_uuid()`]
  final_exam_id uuid [not null]
  student_id uuid [not null]
  status text [not null, default: 'pending']
  submitted_at timestamptz
  grade numeric(5,2)
  notes text
  graded_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (final_exam_id, student_id) [unique]
  }
}

Table student_course_grade {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  class_id uuid [not null]
  task_json_grade_weights jsonb
  group_grades_json jsonb
  attendee_grades_json jsonb
  task_weight numeric(5,2)
  task_total_grade numeric(5,2)
  final_exam_grade numeric(5,2)
  final_exam_weight numeric(5,2)
  type text
  created_at timestamp [default: `now()`]

  indexes {
    (user_id, class_id) [unique]
  }
}

Table equipments {
  id uuid [pk, default: `gen_random_uuid()`]
  name text [not null]
  description text
  quantity integer [default: 0]
  unit_price numeric(10,2) [default: 0]
  created_at timestamp [default: `now()`]
}

Table borrow_equipment {
  id uuid [pk, default: `gen_random_uuid()`]
  equipment_id uuid [not null]
  user_id uuid [not null]
  quantity integer [default: 1]
  borrowed_at timestamp [default: `now()`]
  returned_at timestamp
  status text [default: 'borrowed']
}

Table student_takeouts {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  factor_id uuid
  value numeric(10,2)
  created_at timestamp [default: `now()`]
}

Table email_sent {
  id uuid [pk, default: `gen_random_uuid()`]
  reference_number integer [not null]
  year integer [not null]
  reference_code text [not null, unique]
  title text [not null]
  body text [not null]
  locale text [not null, default: 'ar']
  template_id text [not null]
  created_by uuid
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (year, reference_number) [unique]
  }
}

Table email_users {
  id uuid [pk, default: `gen_random_uuid()`]
  email_sent_id uuid [not null]
  student_id uuid
  email_address text [not null]
  sent_at timestamptz
  delivery_status text [not null, default: 'pending']
  opened_at timestamptz
  mailtrap_message_id text
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (email_sent_id, email_address) [unique]
  }
}

Table permissions {
  key text [pk]
  label text [not null]
  feature_group text [not null]
  access text [not null]
  created_at timestamptz [not null, default: `now()`]
}

Table role_permissions {
  role text [not null]
  permission_key text [not null]

  indexes {
    (role, permission_key) [pk]
  }
}

Table notifications {
  id uuid [pk, default: `gen_random_uuid()`]
  recipient_id uuid
  audience text [not null, default: 'manager']
  category text [not null, default: 'general']
  priority text [not null, default: 'normal']
  title text [not null]
  body text [not null]
  action_href text
  is_read boolean [not null, default: false]
  read_at timestamptz
  created_by uuid
  created_at timestamptz [not null, default: `now()`]
}

Table audit_logs {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid
  user_label text [not null, default: 'System']
  action text [not null]
  severity text [not null, default: 'info']
  table_name text
  record_id uuid
  old_data jsonb
  new_data jsonb
  metadata jsonb
  created_at timestamptz [not null, default: `now()`]
}

Table cloudflare_ai_usage {
  id uuid [pk, default: `gen_random_uuid()`]
  created_at timestamptz [not null, default: `now()`]
  user_id uuid
  user_label text [not null, default: 'Unknown']
  feature text [not null]
  model text [not null]
  prompt text [not null]
  response text
  status text [not null, note: 'success | refused | error']
  error_message text
  prompt_tokens integer
  completion_tokens integer
  total_tokens integer
  tool_rounds integer [not null, default: 0]
  metadata jsonb
}

Table backup_history {
  id uuid [pk, default: `gen_random_uuid()`]
  created_by uuid
  created_by_label text [not null]
  scope text [not null]
  table_name text
  file_name text [not null]
  row_count integer [not null, default: 0]
  table_count integer [not null, default: 0]
  created_at timestamp [not null, default: `now()`]
}

Table app_settings {
  id integer [pk, default: 1]
  maintenance_mode boolean [not null, default: false]
  updated_at timestamptz [not null, default: `now()`]
}

Ref: profiles.id > auth_users.id

Ref: student_profiles.user_id > profiles.id

Ref: classes.subject_id > subjects.id
Ref: classes.semester_id > semesters.id

Ref: class_categories.class_id > classes.id
Ref: class_categories.category_id > categories.id

Ref: categories.parent_id > categories.id
Ref: category_exercises.category_id > categories.id
Ref: category_exercises.exercise_id > exercises.id
Ref: subject_categories.subject_id > subjects.id
Ref: subject_categories.category_id > categories.id
Ref: subject_exercises.subject_id > subjects.id
Ref: subject_exercises.exercise_id > exercises.id

Ref: class_teacher.teacher_id > profiles.id
Ref: class_teacher.class_id > classes.id
Ref: class_teacher.assigned_by > profiles.id

Ref: student_semester.student_profile_id > student_profiles.id
Ref: student_semester.semester_id > semesters.id

Ref: student_class.user_id > profiles.id
Ref: student_class.class_id > classes.id

Ref: sessions.class_id > classes.id
Ref: sessions.semester_id > semesters.id

Ref: attendee.session_id > sessions.id
Ref: attendee.student_id > profiles.id

Ref: tasks.session_id > sessions.id

Ref: student_tasks.task_id > tasks.id
Ref: student_tasks.student_id > profiles.id
Ref: student_task_uploads.student_task_id > student_tasks.id
Ref: student_task_uploads.uploaded_by > profiles.id

Ref: final_exam.class_id > classes.id

Ref: student_finalexam_grade.final_exam_id > final_exam.id
Ref: student_finalexam_grade.student_id > profiles.id

Ref: student_course_grade.user_id > profiles.id
Ref: student_course_grade.class_id > classes.id

Ref: borrow_equipment.equipment_id > equipments.id
Ref: borrow_equipment.user_id > profiles.id

Ref: student_takeouts.user_id > profiles.id

Ref: email_sent.created_by > profiles.id

Ref: email_users.email_sent_id > email_sent.id
Ref: email_users.student_id > profiles.id

Ref: role_permissions.permission_key > permissions.key

Ref: notifications.recipient_id > profiles.id
Ref: notifications.created_by > profiles.id

Ref: audit_logs.user_id > profiles.id
Ref: cloudflare_ai_usage.user_id > profiles.id

Ref: backup_history.created_by > profiles.id

Table payment_phases {
  id uuid [pk, default: `gen_random_uuid()`]
  name text [not null]
  semester_id uuid [not null]
  semester_code text [not null]
  amount numeric(10,2) [not null]
  upfront_amount numeric(10,2) [not null, default: 0]
  duration_months integer [not null]
  start_date date [not null]
  end_date date [not null]
  status text [not null, default: 'opened']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table student_payment_phases {
  id uuid [pk, default: `gen_random_uuid()`]
  student_id uuid [not null]
  payment_phase_id uuid [not null]
  assigned_at date [not null]
  status text [not null, default: 'pending']
  original_amount numeric(10,2) [not null, default: 0]
  adjustment_amount numeric(10,2) [not null, default: 0]
  final_amount_due numeric(10,2) [not null, default: 0]
  total_paid numeric(10,2) [not null, default: 0]
  remaining_amount numeric(10,2) [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (student_id, payment_phase_id) [unique]
  }
}

Table student_payments {
  id uuid [pk, default: `gen_random_uuid()`]
  student_payment_phase_id uuid [not null]
  payment_date date [not null]
  amount numeric(10,2) [not null]
  payment_method text [not null]
  received_by text [not null]
  received_by_management boolean [not null, default: false]
  receipt_number text
  notes text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table student_payment_schedules {
  id uuid [pk, default: `gen_random_uuid()`]
  student_payment_phase_id uuid [not null]
  due_date date [not null]
  amount numeric(10,2) [not null, note: 'CHECK amount > 0; informational only']
  label text [not null, note: 'e.g. Upfront or Installment 2']
  status text [not null, default: 'planned', note: 'planned | paid | waived | cancelled']
  notes text
  created_by uuid
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (student_payment_phase_id, due_date) [name: 'idx_student_payment_schedules_spp']
  }

  Note: 'Informational installments for an SPP. Does not affect financial totals.'
}

Table student_financial_adjustments {
  id uuid [pk, default: `gen_random_uuid()`]
  student_payment_phase_id uuid [not null, unique]
  type text [not null]
  value_type text [not null]
  value numeric(10,2) [not null]
  reason text
  effective_date date [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table student_financial_forms {
  id uuid [pk, default: `gen_random_uuid()`]
  student_payment_phase_id uuid [not null]
  invite_id uuid [unique]
  full_name text [not null]
  school_or_university text
  date_of_birth date
  phone text
  parent_phone text
  current_gpa text
  received_financial_aid_before boolean [not null, default: false]
  certificates text
  family_members integer
  working_family_members integer
  total_family_income numeric(10,2)
  children_currently_learning integer
  has_deceased_parent boolean [not null, default: false]
  both_parents_work boolean [not null, default: false]
  family_hardship boolean [not null, default: false]
  family_chronic_disease boolean [not null, default: false]
  affordable_monthly_payment numeric(10,2)
  student_works boolean [not null, default: false]
  student_monthly_income numeric(10,2)
  agreed_to_rules boolean [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table student_financial_form_invites {
  id uuid [pk, default: `gen_random_uuid()`]
  student_payment_phase_id uuid [not null]
  token text [not null, unique]
  created_by uuid
  created_at timestamptz [not null, default: `now()`]
  used_at timestamptz
  form_id uuid
}

Table transactions {
  id uuid [pk, default: `gen_random_uuid()`]
  transaction_date date [not null]
  type text [not null, note: 'credit | debit']
  amount numeric(10,2) [not null, note: 'always positive; type is direction']
  description text [not null]
  category text [not null, note: 'preset slug for credit/debit lists, or free text when other']
  payment_method text
  recorded_by text [not null]
  notes text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

